rules_version = '2';

// Security rules for Comet Center. These are the real access control: the
// website's own checks are only for a friendly UI. Deploy with:
//   firebase deploy --only firestore:rules
// Test with:  npm run test:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.email.lower(); }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    // IITH = iith.ac.in or any subdomain (coe.iith.ac.in, cse.iith.ac.in …)
    function isIITH() { return email().matches('.*@([a-z0-9-]+[.])*iith[.]ac[.]in'); }
    function myRole() { return isIITH() ? 'student' : 'external'; }
    // The lab account is always an admin. Other admins are listed in config/admins,
    // which admins edit from the website's Admin page.
    function isAdmin() {
      return verified() && (
        email() == 'makerlab.comet@coe.iith.ac.in' ||
        (exists(/databases/$(database)/documents/config/admins) &&
         email() in get(/databases/$(database)/documents/config/admins).data.emails)
      );
    }
    // Only the lab account can add or remove staff.
    function isLabAdmin() { return verified() && email() == 'makerlab.comet@coe.iith.ac.in'; }
    function str(v, max) { return v is string && v.size() <= max; }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'roll', 'createdAt'])
        && request.resource.data.email == email()
        && request.resource.data.role == myRole()
        && str(request.resource.data.name, 80) && request.resource.data.name.size() > 0
        && str(request.resource.data.roll, 30);
      allow update: if verified() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'roll'])
        && str(request.resource.data.name, 80) && request.resource.data.name.size() > 0
        && str(request.resource.data.roll, 30);
    }

    // ---------- jobs (generated from the cost estimator) ----------
    match /jobs/{jobId} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      // The student's browser writes the job, so check every field's shape and size.
      allow create: if verified()
        && jobId.matches('CMT-[0-9]{6}-[A-Z0-9]{4}')
        && request.resource.data.keys().hasOnly(['id', 'uid', 'created', 'status', 'user', 'machine', 'file', 'link', 'note',
             'settings', 'dims', 'fits', 'fitMsg', 'hours', 'grams', 'extra', 'lines', 'base', 'mult', 'band', 'total',
             'img', 'txn', 'shelf', 'log'])
        && request.resource.data.id == jobId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'awaiting'
        && request.resource.data.txn == ''
        && request.resource.data.shelf == ''
        && request.resource.data.created is int
        && request.resource.data.user.keys().hasOnly(['name', 'email', 'roll', 'role'])
        && request.resource.data.user.email == email()
        && request.resource.data.user.role == myRole()
        && str(request.resource.data.user.name, 80) && str(request.resource.data.user.roll, 30)
        && request.resource.data.machine.keys().hasOnly(['key', 'code', 'name', 'tier'])
        && str(request.resource.data.machine.key, 20) && str(request.resource.data.machine.code, 20)
        && str(request.resource.data.machine.name, 80) && request.resource.data.machine.tier in ['A', 'B', 'C']
        && request.resource.data.total is number && request.resource.data.total >= 0
        && request.resource.data.base is number && request.resource.data.mult is number
        && request.resource.data.hours is number && request.resource.data.grams is number
        && request.resource.data.fits is bool
        && request.resource.data.settings is list && request.resource.data.settings.size() <= 20
        && request.resource.data.lines is list && request.resource.data.lines.size() <= 20
        && request.resource.data.dims is list && request.resource.data.dims.size() <= 3
        && request.resource.data.log is list && request.resource.data.log.size() <= 1
        && str(request.resource.data.file, 200)
        && str(request.resource.data.fitMsg, 300) && str(request.resource.data.extra, 300) && str(request.resource.data.band, 60)
        && (request.resource.data.img == '' || (str(request.resource.data.img, 200000) && request.resource.data.img.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')))
        && (request.resource.data.link == '' || (str(request.resource.data.link, 500) && request.resource.data.link.matches('https://[^ "<>]+')))
        && str(request.resource.data.note, 300);
      // Only staff change a job: payment, status, shelf.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'txn', 'verifiedBy', 'verifiedAt', 'shelf', 'log', 'emailSent'])
        // Staff can only clear emailSent (to resend). The email script sets it, and
        // runs as the lab account through Google's own APIs, outside these rules.
        && (!('emailSent' in request.resource.data) || request.resource.data.emailSent == false
            || ('emailSent' in resource.data && resource.data.emailSent == request.resource.data.emailSent))
        && request.resource.data.status in ['awaiting', 'verified', 'printing', 'ready', 'collected', 'cancelled'];
      allow delete: if false;
    }

    // ---------- bookings: one document per machine per hour ----------
    // ID = <machine>_<YYYY-MM-DD>_<hour>, so two people can't book the same slot.
    // No names or emails here: everyone can read bookings to see free slots.
    match /bookings/{slotId} {
      allow read: if true;
      // Booking is switched off on the website, so no new bookings are accepted.
      // To switch it back on, change "if false" back to "if verified()".
      allow create: if false && verified()
        && request.resource.data.keys().hasOnly(['uid', 'role', 'machine', 'date', 'hour', 'start', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == myRole()
        && request.resource.data.hour is int
        && request.resource.data.hour >= 0 && request.resource.data.hour <= 23
        && slotId == request.resource.data.machine + '_' + request.resource.data.date + '_' + string(request.resource.data.hour)
        && request.resource.data.start is timestamp
        && request.resource.data.start > request.time
        && request.resource.data.start < request.time + duration.value(15, 'd');
      // Students cancel their own future slots. Staff can clear any slot.
      allow delete: if (verified() && resource.data.uid == request.auth.uid && resource.data.start > request.time)
        || isAdmin();
      allow update: if false;
    }

    // ---------- config ----------
    match /config/admins {
      allow read: if isAdmin();
      allow write: if isLabAdmin()
        && request.resource.data.emails is list && request.resource.data.emails.size() <= 50;
    }
    // Other settings (config/admins is handled above and excluded here).
    match /config/{doc} {
      allow read: if doc != 'admins';
      allow write: if doc != 'admins' && isAdmin();
    }

    // Everything else is closed.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
